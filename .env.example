# Better Auth (Cloudflare Workers + D1)
# Generate a random 32+ char secret (e.g. `openssl rand -hex 32`)
# For local Wrangler preview/dev, copy values into `.dev.vars` (gitignored).
# For Cloudflare production, set secrets with `npx wrangler secret put BETTER_AUTH_SECRET`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005
